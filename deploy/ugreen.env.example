POSTGRESQL_USERNAME=workbase_admin
POSTGRESQL_PASSWORD=replace-with-a-long-random-password
POSTGRESQL_DATABASE=webnote
BITNAMI_DEBUG=false

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-with-a-different-long-password

POSTGRES_DATA_PATH=/volume1/docker/dbpg/postgres_data
PGADMIN_DATA_PATH=/volume1/docker/dbpg/pgadmin_data
WORKBASE_PORT=3000

# Create a new token after revoking the one exposed in chat.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-a-new-token
