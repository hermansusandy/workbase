# Folder containing the cloned WorkBase repository on the UGREEN NAS.
WORKBASE_APP_PATH=/volume1/docker/workbase
WORKBASE_PORT=3000

# The final path is your existing PostgreSQL database name. Change `webnote` to
# `workbase` only if you create/rename the database itself.
# Replace the password and URL-encode it if it contains reserved URL characters.
DATABASE_URL=postgresql://Admin:replace-with-new-password@postgres_db:5432/webnote

# Revoke the token shared in chat and create a new Cloudflare Tunnel token.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-new-token
